rules_version = '2';

// EcoSteps Firestore rules. Anything not explicitly allowed below is denied.
// Deploy with: firebase deploy --only firestore:rules --project ecosteps-d60b6
//
// Friends work without any server code: a friendship is a document in
// `friendRequests` (id "<fromUid>_<toUid>") that the person asked has
// accepted, and progress is readable by friends only once that exists.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function requestPath(id) {
      return /databases/$(database)/documents/friendRequests/$(id);
    }

    // Has the request from `from` to `to` been accepted?
    function acceptedFrom(from, to) {
      return exists(requestPath(from + '_' + to))
        && get(requestPath(from + '_' + to)).data.status == 'accepted';
    }

    // Is the signed-in user an accepted friend of `uid` (either direction)?
    function isFriendOf(uid) {
      return signedIn()
        && (acceptedFrom(uid, request.auth.uid)
            || acceptedFrom(request.auth.uid, uid));
    }

    // Only the app's owner may write the demo friends (see below).
    function isAppOwner() {
      return signedIn() && request.auth.token.email == 'pennock.thomas@gmail.com';
    }

    function shortText(value) {
      return value is string && value.size() > 0 && value.size() <= 60;
    }

    match /users/{uid} {
      // The profile (name, friend code): the owner and accepted friends.
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow write: if isOwner(uid);

      // Counts for friends to read (see ProgressSync). Counts only: no swap
      // names are ever written here.
      match /progress/summary {
        allow read: if isOwner(uid) || isFriendOf(uid);
        allow write: if isOwner(uid);
      }

      // Every swap ticked or unticked, for syncing between devices (see
      // ProgressStateSync). Only the owner, and only this shape: a list of
      // at most 2000 entries.
      match /progress/state {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['schema', 'items', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 2000;
      }
    }

    // Friend codes: look one up by its code (get). There is deliberately no
    // list, so nobody can browse or count accounts. A code can't be taken
    // over: only its owner can change or remove it.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.displayName);
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName'])
        && request.resource.data.uid == request.auth.uid
        && shortText(request.resource.data.displayName);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Friend requests. Only the two people involved can see one; only the
    // person asked can accept; either can delete it (decline, cancel, remove).
    match /friendRequests/{requestId} {
      // The id contains both uids, so a get can be checked without the
      // document existing (the app looks for a request before sending one).
      allow get: if signedIn()
        && (requestId.matches(request.auth.uid + '_.*')
            || requestId.matches('.*_' + request.auth.uid));
      allow list: if signedIn()
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
            ['from', 'to', 'fromName', 'toName', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data.fromName)
        && shortText(request.resource.data.toName);

      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid
            || resource.data.to == request.auth.uid);
    }

    // ---------------------------------------------------------------- houses
    // A house is a small group (at most 8 people) who see each other's swap
    // counts. Everyone in a house has equal rights: any member can rename it,
    // invite one of their friends, remove people or leave. Nobody can join
    // without an invitation from a member.

    function houseDoc(houseId) {
      return /databases/$(database)/documents/houses/$(houseId);
    }

    function isHouseMember(houseId) {
      return signedIn() && request.auth.uid in get(houseDoc(houseId)).data.memberUids;
    }

    function houseName(value) {
      return value is string && value.size() > 0 && value.size() <= 40;
    }

    match /houses/{houseId} {
      allow get: if signedIn() && request.auth.uid in resource.data.memberUids;
      // "My houses": a query on memberUids array-contains my uid.
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'memberUids', 'createdBy', 'createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && houseName(request.resource.data.name);

      // A member renames the house or removes people (themselves included),
      // but can never add anyone this way.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberUids'])
        && houseName(request.resource.data.name)
        && request.resource.data.memberUids.size() >= 1
        && request.resource.data.memberUids.hasOnly(resource.data.memberUids);

      // Joining: only as yourself, only with an invitation, only by adding
      // your own uid to the end, only while there is room.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberUids)
        && exists(/databases/$(database)/documents/houseInvites/$(houseId + '_' + request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
        && request.resource.data.memberUids.size() <= 8;

      // The last person leaving takes the house with them.
      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.memberUids.size() == 1;

      // Each member's name in this house (what the others see next to their
      // swaps). Written only by that member.
      match /members/{memberUid} {
        allow read: if isHouseMember(houseId);
        allow create, update: if isOwner(memberUid)
          && isHouseMember(houseId)
          && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
          && shortText(request.resource.data.name);
        // Removing someone starts with deleting their name (while both are
        // still members), so any member may.
        allow delete: if isOwner(memberUid) || isHouseMember(houseId);
      }

      // The house's shared tree: which swaps are done, and which branches
      // are open. Any member can change them, and each change records who
      // made it (always themselves) and when. Unticking writes done=false
      // (never a delete), so there is always a record.
      match /swaps/{swapId} {
        allow read: if isHouseMember(houseId);
        allow create, update: if isHouseMember(houseId)
          && swapId.size() <= 100
          && request.resource.data.keys().hasOnly(['done', 'at', 'by'])
          && request.resource.data.done is bool
          && request.resource.data.at is int
          && request.resource.data.by == request.auth.uid;
        allow delete: if false;
      }

      match /tiers/{tierLabel} {
        allow read: if isHouseMember(houseId);
        allow create, update: if isHouseMember(houseId)
          && tierLabel.size() <= 100
          && request.resource.data.keys().hasOnly(['open', 'at', 'by'])
          && request.resource.data.open is bool
          && request.resource.data.at is int
          && request.resource.data.by == request.auth.uid;
        allow delete: if false;
      }
    }

    // Invitations to a house, "<houseId>_<invitedUid>". Only a member can
    // invite, only a friend of theirs, and only someone not already inside.
    match /houseInvites/{inviteId} {
      allow get: if signedIn() && inviteId.matches('.*_' + request.auth.uid);
      allow list: if signedIn()
        && (resource.data.to == request.auth.uid
            || isHouseMember(resource.data.houseId));

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
            ['houseId', 'houseName', 'from', 'fromName', 'to', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && inviteId == request.resource.data.houseId + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data.fromName)
        && isHouseMember(request.resource.data.houseId)
        && request.resource.data.houseName == get(houseDoc(request.resource.data.houseId)).data.name
        && !(request.resource.data.to in get(houseDoc(request.resource.data.houseId)).data.memberUids)
        && get(houseDoc(request.resource.data.houseId)).data.memberUids.size() < 8
        && (acceptedFrom(request.auth.uid, request.resource.data.to)
            || acceptedFrom(request.resource.data.to, request.auth.uid));

      // Declining, cancelling, or clearing it after joining.
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid
            || resource.data.from == request.auth.uid
            || isHouseMember(resource.data.houseId));
    }

    // Made-up friends for showing how the Friends screen works. Fake data
    // only, so anyone can read it; only the app's owner can write it.
    match /demoFriends/{demoId} {
      allow read: if true;
      allow write: if isAppOwner();
    }
  }
}
