rules_version = '2';

// EcoSteps Firestore rules. Anything not explicitly allowed below is denied.
// Deploy with: firebase deploy --only firestore:rules --project ecosteps-d60b6
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Phase 3b/3d: each user can read and write only their own profile and
    // progress documents. Friends' read access is added in Phase 3c/3d, once
    // an accepted-friends list exists to check against.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Counts for friends to read (see ProgressSync).
      match /progress/summary {
        allow read, write: if isOwner(uid);
      }

      // Every swap ticked or unticked, for syncing between devices (see
      // ProgressStateSync). Only the owner, and only this shape: a list of
      // at most 2000 entries.
      match /progress/state {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['schema', 'items', 'updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 2000;
      }
    }
  }
}
